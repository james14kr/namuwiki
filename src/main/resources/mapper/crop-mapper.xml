<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 해당 파일에 모든 쿼리문을 작성 -->
<!-- namespace에는 xml파일과 연결할 Mapper interface 파일명을 패키지를 포함하여 적어주세요 -->
<mapper namespace="com.green.namuwiki.crop.mapper.CropMapper">

    <!--농작물 등록-->
    <insert id="insertCrop" parameterType="com.green.namuwiki.crop.dto.CropDTO">
        INSERT INTO CROP(FARM_ID,
            CROP_NAME
            ,CROP_DESC
            ,CROP_PRICE
            ,CROP_IMG
        )
        VALUES(
            #{farmId},
            #{cropName},
            #{cropDesc},
            #{cropPrice},
            #{cropImg}
        )
    </insert>

    <!--등록한 농작물 목록 조회-->
    <select id="getCropListByFarmId" parameterType="int" resultType="com.green.namuwiki.crop.dto.CropDTO">
        SELECT CROP_ID AS cropId
            ,FARM_ID AS farmId
            ,CROP_NAME AS cropName
            ,CROP_DESC AS cropDesc
            ,CROP_PRICE AS cropPrice
            ,CROP_IMG AS cropImg
        FROM CROP
        WHERE FARM_ID = #{farmId}
    </select>

    <!--농장 ID로 해당 농장의 모든 농작물 삭제-->
    <!--FARM 삭제 전 반드시 먼저 실행해야 FK제약조건 오류를 피할 수 있음-->
    <delete id="deleteCropByFarmId" parameterType="int">
        DELETE FROM CROP
        WHERE FARM_ID = #{farmID}
    </delete>

    <!--농작물 ID로 해당 농작물 삭제-->
    <delete id="deleteCrop" parameterType="int">
        DELETE FROM CROP
        WHERE CROP_ID = #{cropId}
    </delete>

    <select id="getCropListByFarmerEmail" parameterType="String" resultType="com.green.namuwiki.crop.dto.CropDTO">
        SELECT C.CROP_ID AS cropId,
            C.FARM_ID AS farmId,
            C.CROP_NAME AS cropName,
            C.CROP_DESC AS cropDesc,
            C.CROP_PRICE AS cropPrice,
            C.CROP_IMG AS cropImg
        FROM CROP C
        JOIN FARM F ON C.FARM_ID = F.FARM_ID
        WHERE F.FARMER_EMAIL = #{farmerEmail}
        ORDER BY C.CROP_ID DESC
    </select>

</mapper>































